{
  "name": "tui2web",
  "version": "0.1.0",
  "description": "Open any terminal program (like Claude Code) on your phone: tui2web claude",
  "keywords": [
    "terminal",
    "tui",
    "pty",
    "remote",
    "mobile",
    "claude",
    "claude-code",
    "xterm"
  ],
  "homepage": "https://github.com/czhu12/tui2web#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/czhu12/tui2web.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/czhu12/tui2web/issues",
  "license": "MIT",
  "type": "module",
  "bin": {
    "tui2web": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@tui2web/protocol": "*"
  }
}
